		"activities": [
			{
				"name": "Az Func Bedstat-Excel-Creation",
				"type": "AzureFunctionActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"functionName": "GenerateBedStatExcel",
					"body": {
						"csvBlobPath": "2026/10/30/All_Homes_Bedstat_2026-10-30.csv"
					},
					"headers": {
						"Content-Type": "application/json"
					},
					"method": "POST"
				},
				"linkedServiceName": {
					"referenceName": "AZFunc_Bedstat_Excel_Generation",
					"type": "LinkedServiceReference"
				}
			}
		],
		"folder": {
			"name": "BedStats"
		},
		"annotations": []
	}
}