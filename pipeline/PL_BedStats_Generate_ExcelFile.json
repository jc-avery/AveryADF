{
	"name": "PL_BedStats_Generate_ExcelFile",
	"properties": {
		"description": "Calls the AZ Func Bedstats-Excel-Creation to generate an excel file using the csv blob passed to it",
		"activities": [
			{
				"name": "Az Func Bedstat-Excel-Creation",
				"type": "AzureFunctionActivity",
				"dependsOn": [
					{
						"activity": "Set vDirectory",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set vTodaysDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"functionName": "GenerateBedStatExcel",
					"body": {
						"value": "@concat('{\"csvBlobPath\": \"',variables('vDirectory'),'/All_Homes_Bedstat_',variables('vTodaysDate'),'.csv\"}')",
						"type": "Expression"
					},
					"headers": {
						"Content-Type": "application/json"
					},
					"method": "POST"
				},
				"linkedServiceName": {
					"referenceName": "AZFunc_Bedstat_Excel_Generation",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set vDirectory",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vDirectory",
					"value": {
						"value": "@utcNow('yyyy/MM/dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set vTodaysDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vTodaysDate",
					"value": {
						"value": "@utcNow('yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"vDirectory": {
				"type": "String"
			},
			"vTodaysDate": {
				"type": "String"
			}
		},
		"folder": {
			"name": "BedStats"
		},
		"annotations": []
	}
}