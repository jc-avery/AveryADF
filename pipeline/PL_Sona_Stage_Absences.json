{
	"name": "PL_Sona_Stage_Absences",
	"properties": {
		"activities": [
			{
				"name": "Stage Absences",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Clear Stage Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['id']"
								},
								"sink": {
									"name": "absence_id"
								}
							},
							{
								"source": {
									"path": "['user_id']"
								},
								"sink": {
									"name": "user_id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['starts_at']"
								},
								"sink": {
									"name": "starts_at",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "['absence_type_id']"
								},
								"sink": {
									"name": "absence_type_id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['absence_subtype_id']"
								},
								"sink": {
									"name": "absence_subtype_id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['ends_at']"
								},
								"sink": {
									"name": "ends_at",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "['is_open_ended']"
								},
								"sink": {
									"name": "is_open_ended",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['payroll_type']"
								},
								"sink": {
									"name": "payroll_type",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['is_paid']"
								},
								"sink": {
									"name": "is_paid",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['current_employee_number']"
								},
								"sink": {
									"name": "current_employee_number",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['user_internal_id']"
								},
								"sink": {
									"name": "user_internal_id",
									"type": "String"
								}
							}
						],
						"collectionReference": "$['entries']"
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Sona_Json_WeeklyHrs",
						"type": "DatasetReference",
						"parameters": {
							"FileName": "All_absences$",
							"DateString": {
								"value": "@variables('DateString')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_AH2_TRANSFORM_DB",
						"type": "DatasetReference",
						"parameters": {
							"Schema": "Sona",
							"Table": "STG_Absences"
						}
					}
				]
			},
			{
				"name": "Set DateString",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "DateString",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Flatten Days",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Stage Absences",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DF_Sona_Absences_Flatten",
						"type": "DataFlowReference",
						"datasetParameters": {
							"SonaAbscenses": {
								"FileName": "All_absences$",
								"DateString": {
									"value": "@variables('DateString')",
									"type": "Expression"
								}
							},
							"InsertAbsenceDays": {
								"Schema": "Sona",
								"Table": "STG_Absences_Days"
							},
							"InsertAbsenceLinkedShifts": {
								"Schema": "Sona",
								"Table": "STG_Absences_Linked_Shifts"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "Clear Stage Tables",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Set DateString",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AH2_TRANSFORM_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "TRUNCATE TABLE Sona.STG_Absences\nTRUNCATE TABLE Sona.STG_Absences_Days\nTRUNCATE TABLE Sona.STG_Absences_Linked_Shifts"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Clean Duplicate Absence Records",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Flatten Days",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AH2_TRANSFORM_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "EXEC Sona.Remove$DuplicateAbsenceReords"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"variables": {
			"DateString": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Sona/Child Pipelines/Absences"
		},
		"annotations": []
	}
}