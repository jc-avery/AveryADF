{
	"name": "PL_Sona_Get_WeeklyHrs_ADFv",
	"properties": {
		"activities": [
			{
				"name": "Call Sona API",
				"description": "Call the Sona API with provided Endpoint and Start End date times. Copy Activity handles pagination, cycling through each page (RANGE1::1 start:end:offset) until entries is empty (EndCondition:$.entries = Empty)",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set API Parameter Names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.15:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.500",
						"requestMethod": "GET",
						"paginationRules": {
							"QueryParameters.{page}": "RANGE:1::1",
							"EndCondition:$.entries": "Empty",
							"MaxRequestNumber": {
								"value": "@pipeline().parameters.MaxRequestLimit",
								"type": "Expression"
							}
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_Sona_API",
						"type": "DatasetReference",
						"parameters": {
							"EndPoint": {
								"value": "@concat('/api/v1/',pipeline().parameters.EndPoint,'?page={page}&page_size=',pipeline().parameters.PageSize,'&',variables('vStartDateTime'),'=',pipeline().parameters.StartDateTime,'&',variables('vEndDateTime'),'=',pipeline().parameters.EndDateTime)",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Sona_API_Response",
						"type": "DatasetReference",
						"parameters": {
							"FileName": {
								"value": "@concat(pipeline().parameters.FileName,'-',pipeline().parameters.EndPoint)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Set API Parameter Names",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.EndPoint",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "pay_lines",
							"activities": [
								{
									"name": "Set StartDateTime_pay_lines",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vStartDateTime",
										"value": "start_datetime"
									}
								},
								{
									"name": "Set EndDateTime_pay_lines",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Set StartDateTime_pay_lines",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vEndDateTime",
										"value": "end_datetime"
									}
								}
							]
						},
						{
							"value": "shifts",
							"activities": [
								{
									"name": "Set StartDateTime_shifts",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vStartDateTime",
										"value": "min_start_datetime"
									}
								},
								{
									"name": "Set EndDateTime_shifts",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Set StartDateTime_shifts",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vEndDateTime",
										"value": "max_start_datetime"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"StartDateTime": {
				"type": "string"
			},
			"EndDateTime": {
				"type": "string"
			},
			"EndPoint": {
				"type": "string"
			},
			"PageSize": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			},
			"MaxRequestLimit": {
				"type": "int",
				"defaultValue": 120
			}
		},
		"variables": {
			"vStartDateTime": {
				"type": "String"
			},
			"vEndDateTime": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Sona/Child Pipelines/Weekly Hours"
		},
		"annotations": []
	}
}