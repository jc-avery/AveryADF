{
	"name": "PL_NurseCall_InterCall_Export",
	"properties": {
		"description": "Export data to storage account, trigger logic app to retrieve and upload it to sharepoint",
		"activities": [
			{
				"name": "Export InterCall Data",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Set vFileName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[InterCall].[Export$DataForSharePoint]",
						"storedProcedureParameters": {
							"ExportType": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.ExportType",
									"type": "Expression"
								}
							},
							"Home": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.Home",
									"type": "Expression"
								}
							},
							"ReportEndDate": {
								"type": "DateTime",
								"value": {
									"value": "@variables('vReportEndDate')",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_AH2_TRANSFORM_DB",
						"type": "DatasetReference",
						"parameters": {
							"Schema": "n/a",
							"Table": "n/a"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_NurseCall_Csv",
						"type": "DatasetReference",
						"parameters": {
							"Directory": {
								"value": "@variables('vBlobDirectory')",
								"type": "Expression"
							},
							"Filename": {
								"value": "@variables('vFileName')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Sharepoint Upload Loagic App",
				"type": "WebActivity",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Export InterCall Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-02.uksouth.logic.azure.com:443/workflows/903c7073354244b39c958df4c32b5808/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=YlUoy6EnlkhMdKMaNCvochikCY-hcJt38yogyvE6wNM",
					"body": {
						"value": "{\n    \"extractType\": \"@{pipeline().parameters.ExportType}\",\n    \"reportDate\": \"@{variables('vReportEndDate')}\",\n    \"blobDirectory\": \"@{variables('vBlobDirectory')}\",\n    \"sharePointDirectory\": \"@{variables('vSharePointDirectory')}\",\n    \"fileName\": \"@{variables('vFileName')}\",\n    \"home\": \"@{pipeline().parameters.Home}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set vFileName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Switch Set vSharePointDirectory And vFileNameDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Switch Set Blob Directory",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vFileName",
					"value": {
						"value": "@concat(pipeline().parameters.Home,'_NurseCall_Data_export_',pipeline().parameters.ExportType,'_',variables('vFileNameDate'),'.csv')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition - check if true",
				"type": "IfCondition",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.ExportType,'Daily')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Switch Expression",
				"type": "Switch",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "If Condition - check if true",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.ExportType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Daily",
							"activities": [
								{
									"name": "Set vReportDate_Daily",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vReportEndDate",
										"value": {
											"value": "@addDays(utcNow(), -1,'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "Weekly",
							"activities": [
								{
									"name": "Set vReportDate_Weekly",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vReportEndDate",
										"value": {
											"value": "@addDays(utcNow(), -5,'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Set vReportEndDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vReportEndDate",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Switch Set vSharePointDirectory And vFileNameDate",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Set vReportEndDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.ExportType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Daily",
							"activities": [
								{
									"name": "Set vDirectoryDate_Daily",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Set vFileNameDate_Daily",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vSharePointDirectory",
										"value": {
											"value": "@concat(formatDateTime(variables('vFileNameDate'), 'yyyy'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'MM'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'dd') )",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Set vFileNameDate_Daily",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vFileNameDate",
										"value": {
											"value": "@formatDateTime(addDays(variables('vReportEndDate'), -1 ), 'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "Weekly",
							"activities": [
								{
									"name": "Set vFileNameDate_Weekly",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vFileNameDate",
										"value": {
											"value": "@addDays(variables('vReportEndDate'), -7,'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Set vDirectoryDate_Weekly",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Set vFileNameDate_Weekly",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vSharePointDirectory",
										"value": {
											"value": "@concat(formatDateTime(variables('vFileNameDate'), 'yyyy'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'MM'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'dd') )",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "Monthly",
							"activities": [
								{
									"name": "Set vFileNameDate_Monthly",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vFileNameDate",
										"value": {
											"value": "@formatdatetime(addToTime(variables('vReportEndDate'), -1, 'Month'), 'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Set vSharePointDirectory_Monthly",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Set vFileNameDate_Monthly",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vSharePointDirectory",
										"value": {
											"value": "@concat(formatDateTime(variables('vFileNameDate'), 'yyyy'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'MM'),\n\t'/',formatDateTime(variables('vFileNameDate'), 'dd') )",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Switch Set Blob Directory",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Set vReportEndDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.ExportType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Daily",
							"activities": [
								{
									"name": "Set vBlobDirectory_Daily",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vBlobDirectory",
										"value": {
											"value": "@formatDateTime(addDays(variables('vReportEndDate'), -1), 'yyyy/MM/dd')",
											"type": "Expression"
										}
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Set vBlobDirectory",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vBlobDirectory",
								"value": "@concat(formatDateTime(variables('vReportEndDate'), 'yyyy'),'/',formatDateTime(variables('vReportEndDate'), 'MM'),'/',formatDateTime(variables('vReportEndDate'), 'dd') )"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"ExportType": {
				"type": "string"
			},
			"Home": {
				"type": "string"
			}
		},
		"variables": {
			"vBlobDirectory": {
				"type": "String"
			},
			"vFileName": {
				"type": "String"
			},
			"vReportEndDate": {
				"type": "String"
			},
			"vSharePointDirectory": {
				"type": "String"
			},
			"vFileNameDate": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Nurse Calls"
		},
		"annotations": []
	}
}