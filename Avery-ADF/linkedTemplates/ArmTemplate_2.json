			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Track Details Record Count",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "AH2_TRANSFORM_DB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "INSERT INTO Exchequer.DetailsRecordCount (RecordCount, CountDateTime, tlYear)\nSELECT COUNT(*), GETDATE(), 126 FROM Exchequer.Details WITH (NOLOCK) WHERE tlYear = 126"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
