		{
			"name": "[concat(parameters('factoryName'), '/PL_BedStats_Upload_Excel_ToSharePoint')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "BedStat-SharePoint-Upload Logic App",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "Set vblobPath",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": "https://prod-30.uksouth.logic.azure.com:443/workflows/bdc7d6b0bf8a4b509d557534d66b0e93/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=9EFt_Oz8tLOpvamW4yW_Ckckw9GKHLXdZlBuwpV7yEo",
							"body": {
								"value": "{\n  \"blobPath\": \"@{variables('vblobPath')}\",\n  \"sharePointDirectory\": \"@{variables('vsharePointDirectory')}\",\n  \"fileName\": \"@{variables('vfileName')}\",\n  \"home\": null\n}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set vDirectory",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set vsharePointDirectory",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "vDirectory",
							"value": {
								"value": "@concat('excel/',variables('vsharePointDirectory'),'/')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set vTodaysDate",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "vTodaysDate",
							"value": {
								"value": "@utcNow('yyyy-MM-dd')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set vfileName",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set vTodaysDate",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "vfileName",
							"value": {
								"value": "@concat('All_Homes_Bedstat_',variables('vTodaysDate'),'.xlsx')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set vblobPath",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set vDirectory",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set vfileName",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "vblobPath",
							"value": {
								"value": "@concat(variables('vDirectory'),variables('vfileName'))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set vsharePointDirectory",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "vsharePointDirectory",
							"value": {
								"value": "@utcNow('yyyy/MM/dd')",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"vDirectory": {
						"type": "String"
					},
					"vTodaysDate": {
						"type": "String"
					},
					"vblobPath": {
						"type": "String"
					},
					"vfileName": {
						"type": "String"
					},
					"vsharePointDirectory": {
						"type": "String"
					}
				},
				"folder": {
					"name": "BedStats"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
